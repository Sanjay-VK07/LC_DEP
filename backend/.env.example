PORT=3001
# TiDB Cloud Serverless (100% Free Forever, No Expiration, Never Sleeps)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_username
DB_PASSWORD=your_tidb_password
DB_NAME=college_db
DB_CA_PATH=/etc/ssl/cert.pem
DB_SSL=true
JWT_SECRET=super_secret_jwt_key_123_attendance_system
FRONTEND_URL=https://college-teal-ten.vercel.app
LEETCODE_CONTEST_API=https://leetcode.com/contest/api/ranking
LEETCODE_PAGE_CONCURRENCY=2
LEETCODE_PAGE_DELAY_MS=1000
LEETCODE_MAX_RETRIES=3
LEETCODE_BACKOFF_BASE_MS=1000
LEETCODE_CACHE_TTL_MS=3600000
LEETCODE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/121.0.0.0 Safari/537.36
LEETCODE_ACCEPT=application/json, text/plain, */*
LEETCODE_ACCEPT_LANGUAGE=en-US,en;q=0.9
LEETCODE_REFERER=https://leetcode.com/contest/
LEETCODE_ORIGIN=https://leetcode.com
VITE_API_URL=https://college-slov.onrender.com/api

# Leet.ai Integration Config
LEETAI_API_BASE_URL=https://leet.ai/open_api/v1
LEETAI_API_TIMEOUT_MS=30000
LEETAI_MAX_RETRIES=3

# CLIST Integration Config (required for attendance sync — all attendance syncs
# route through ClistAdapter; without these the provider is disabled and syncs
# will report NOT_VERIFIED / preserve existing attendance without updating it)
CLIST_USERNAME=
CLIST_API_KEY=


